{
    "name": "brainx/bxmpvendor",
    "description": "BrainX marketplace vendor portal (front-office vendor dashboards, offers, positioning, orders, analytics)",
    "type": "prestashop-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "BrainX\\MarketplaceVendor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrainX\\MarketplaceVendor\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "autoloader-suffix": "BxMpVendor",
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@composer install --no-interaction --quiet",
            "phpunit"
        ],
        "build": "@composer install --no-dev --no-interaction"
    },
    "scripts-descriptions": {
        "test": "Install dev deps (phpunit) and run the unit suite (pure logic)",
        "build": "Re-generate the committed no-dev autoloader (run before committing)"
    }
}
