{
    "name": "brainx/bxmpcheckout",
    "description": "BrainX marketplace: multi-vendor carrier, cart optimizer integration, order split and payment allocation for PrestaShop 9",
    "type": "prestashop-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "BrainX\\MarketplaceCheckout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrainX\\MarketplaceCheckout\\Tests\\": "tests/Unit/",
            "BrainX\\Marketplace\\": "../bxmarketplace/src/"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "autoloader-suffix": "BxmpCheckout",
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@composer install --no-interaction --quiet",
            "phpunit"
        ],
        "build": "@composer install --no-dev --no-interaction"
    },
    "scripts-descriptions": {
        "test": "Install dev deps (phpunit) and run the unit suite",
        "build": "Re-generate the committed no-dev autoloader (run before committing)"
    }
}
