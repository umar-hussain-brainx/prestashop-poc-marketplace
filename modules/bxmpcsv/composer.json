{
    "name": "brainx/bxmpcsv",
    "description": "BrainX Marketplace: standardized vendor CSV import/export, scheduled feeds, matching exception queue",
    "type": "prestashop-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "BrainX\\Csv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrainX\\Csv\\Tests\\": "tests/",
            "BrainX\\Marketplace\\": "../bxmarketplace/src/"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "autoloader-suffix": "BxmpCsv",
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@composer install --no-interaction --quiet",
            "phpunit"
        ],
        "build": "@composer install --no-dev --no-interaction"
    },
    "scripts-descriptions": {
        "test": "Install dev deps (phpunit) and run the parser/validator/mapper suite",
        "build": "Re-generate the committed no-dev autoloader (run before committing)"
    }
}
