{
    "name": "brainx/bxmarketplace",
    "description": "BrainX multi-vendor marketplace core module for PrestaShop 9 (schema, ObjectModels, domain engines, internal API)",
    "type": "prestashop-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "BrainX\\Marketplace\\": "src/"
        },
        "classmap": [
            "classes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BrainX\\Marketplace\\Tests\\": "tests/"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "autoloader-suffix": "BxMarketplace",
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@composer install --no-interaction --quiet",
            "phpunit"
        ],
        "build": "@composer install --no-dev --no-interaction"
    },
    "scripts-descriptions": {
        "test": "Install dev deps (phpunit) and run the domain test-suite",
        "build": "Re-generate the committed no-dev autoloader (run before committing)"
    }
}
